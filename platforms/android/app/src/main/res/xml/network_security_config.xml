<?xml version="1.0" encoding="utf-8"?>
<!-- Providers often serve media, playlists and logos over plain HTTP. System certificate validation is unchanged. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

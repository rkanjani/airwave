<?xml version="1.0" encoding="utf-8"?>
<!-- Fetches the saved playlist or library URL and parses it off the render thread. -->
<component name="LoadTask" extends="Task">
    <interface>
        <field id="url" type="string"/>
        <field id="result" type="assocarray"/>
    </interface>
    <script type="text/brightscript" uri="pkg:/source/core.brs"/>
    <script type="text/brightscript" uri="pkg:/components/LoadTask.brs"/>
</component>

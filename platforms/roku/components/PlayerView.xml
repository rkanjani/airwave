<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen playback. The scene sets `request`; the view reports progress, favorite requests and closing. -->
<component name="PlayerView" extends="Group">
    <interface>
        <field id="request" type="assocarray" onChange="onRequest"/>
        <field id="progress" type="assocarray" alwaysNotify="true"/>
        <field id="favoriteRequest" type="string" alwaysNotify="true"/>
        <field id="closed" type="boolean" alwaysNotify="true"/>
    </interface>
    <script type="text/brightscript" uri="pkg:/source/core.brs"/>
    <script type="text/brightscript" uri="pkg:/components/Fonts.brs"/>
    <script type="text/brightscript" uri="pkg:/components/PlayerView.brs"/>
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF"/>
        <Video id="video" width="1920" height="1080" enableUI="true"/>
        <Group id="status" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000E6"/>
            <Label id="statusTitle" translation="[160,380]" width="1600" wrap="true" color="0xFFFFFFFF"/>
            <Label id="statusText" translation="[160,460]" width="1300" wrap="true" maxLines="4" color="0xB4B4B4FF" lineSpacing="8"/>
            <Label id="statusHint" translation="[160,640]" width="1600" color="0x949494FF"/>
        </Group>
    </children>
</component>
